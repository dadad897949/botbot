# Bot 通知客户端（2026-10-04：转存通知走 bot，收藏夹不留通知）

async def progress_notifier(client):
    # H3: 首次播报从 10 分钟提前到 2 分钟，避免用户以为机器人死了
    await asyncio.sleep(120)  # first report after 2 min, only if still busy
    while True:
        if tasks.active:
            lines = []
            for key in list(tasks.active):
                st = tasks.active.get(key)
                if st is None:
                    continue
                phase = st.get('phase', '传输中')
                prog = tasks.progress_of(key)
                if prog is None:
                    continue
                lines.append('⏳ %s：%s' % (phase, prog))
            try:
                await client.send_message(OWNER, '\n'.join(lines))
            except Exception:
                pass
        await asyncio.sleep(600)


async def main():
    # 初始化各集合模块
    HISTORY_FILE = os.path.join(BASE_DIR, 'history.jsonl')
    tasks.init(INBOX)
    history.init(HISTORY_FILE, tasks, transfer)
    # handlers 的 init 需要 client，稍后在 client 创建后调用
    # 启动清理：有 resume 状态的文件保留（断点续传），其余残留清掉
    # 用 resume.json 里的精确 path 匹配（key 子串匹配有误判风险，已去掉）
    try:
        resumable_paths = set()
        for rf in os.listdir(INBOX):
            if rf.endswith('.resume.json'):
                try:
                    with open(os.path.join(INBOX, rf)) as jf:
                        _rs = json.load(jf)
                        if _rs.get('path'):
                            resumable_paths.add(_rs['path'])
                except (OSError, ValueError):
                    pass
        stale = []
        kept = 0
        for f in os.listdir(INBOX):
            fp = os.path.join(INBOX, f)
            if not os.path.isfile(fp):
                continue
            if f.endswith('.resume.json'):
                continue
            if fp in resumable_paths:
                kept += 1
            else:
                stale.append(f)
        for f in stale:
            try:
                os.remove(os.path.join(INBOX, f))
            except OSError:
                pass
        if stale:
            print('STARTUP_CLEAN removed %d stale files' % len(stale), flush=True)
        if kept:
            print('STARTUP_KEEP %d resumable files' % kept, flush=True)
    except OSError as e:
        print('STARTUP_CLEAN_FAIL %s' % e, flush=True)
    client = TelegramClient(os.path.join(BASE_DIR, 'user_session'),
                            API_ID, API_HASH, proxy=proxy)
    # 初始化消息处理模块（需要 client）
    handlers.init(client, OWNER, INBOX, BASE_DIR, transfer, cloudmod,
                  fastdl, notify, tasks, history, API_ID, API_HASH, proxy)
    # 启动时清理遗留任务的云端残缺目录（2026-10-07：重启中断任务自动删目录）
    try:
        _orphaned = handlers.get_orphaned_tasks()
        for _okey, _oinfo in _orphaned.items():
            try:
                # 重建 targets 用于 cleanup（需要 drive 对象）
                _otargets = []
                for _c in _oinfo.get('cloud', []):
                    try:
                        _drv = cloudmod.connect(_c.get('drive_key', 'ali'))
                        # 构造简单的 Target 对象
                        _t = type('T', (), {
                            'key': _c.get('drive_key', 'ali'),
                            'drive': _drv,
                            'fid': _c.get('fid', ''),
                            'reuse': _c.get('reuse', False),
                            'label': _c.get('label', ''),
                        })()
                        _otargets.append(_t)
                    except Exception:
                        pass
                if _otargets:
                    cloudmod.cleanup(_otargets)
                    print('STARTUP_ORPHAN_CLEAN %s (%s)' % (_okey, _oinfo.get('type', '?')), flush=True)
                # 删本地文件
                for _p in _oinfo.get('local_paths', []):
                    try:
                        if _p and os.path.exists(_p):
                            if os.path.isdir(_p):
                                import shutil
                                shutil.rmtree(_p)
                            else:
                                os.remove(_p)
                    except Exception:
                        pass
                # 清记录
                handlers.complete_task(_okey)
            except Exception as _oe:
                print('STARTUP_ORPHAN_FAIL %s: %r' % (_okey, _oe), flush=True)
        if _orphaned:
            print('STARTUP_ORPHAN done: %d' % len(_orphaned), flush=True)
    except Exception as e:
        print('STARTUP_ORPHAN_FAIL: %r' % e, flush=True)
    # 2026-10-07：检查 getbot 缓存，有未完成任务则告警（自动恢复后续做）
    try:
        from tg_bot.getbot_cache import get_incomplete_tasks as _gbc_incomplete
        _gbc_tasks = _gbc_incomplete()
        for _t in _gbc_tasks:
            print('STARTUP_CACHE_INCOMPLETE task=%s bot=%s pending=%d/%d cloud=%s' % (
                _t['task_id'], _t['bot_username'], _t['pending'], _t['total'], _t['cloud_dir']), flush=True)
        if _gbc_tasks:
            print('STARTUP_CACHE: %d incomplete tasks found, manual resume needed' % len(_gbc_tasks), flush=True)
    except Exception as _ce:
        print('STARTUP_CACHE_CHECK_FAIL: %r' % _ce, flush=True)
    # 用户身份登录（2026-10-02 改为同步收藏夹）：用已保存的 user_session，
    # 不再用 bot_token
    # handler 必须在 start() 之前注册，否则收不到更新
    @client.on(_tele_events.NewMessage)
    async def on_msg(event):
        # 用户模式：只处理自己发出的消息（收藏夹同步 + 命令）
        if event.sender_id != OWNER_ID:
            return
        # 2026-10-05: 收藏夹不通知，所有回复转到 bot
        async def _reply(text=None, file=None, message=None):
            try:
                txt = text if text is not None else message
                if file:
                    await notify._bot_client.send_file(OWNER_ID, file, caption=txt)
                else:
                    await notify.bot_notify(txt)
            except Exception as e:
                print('BOT_REPLY_FAIL: %r' % e, flush=True)
        msg = event.message
        # 收藏夹（Saved Messages）：chat_id == 自己的 id
        is_saved = event.chat_id == OWNER_ID
        # 只在收藏夹响应，避免在其他机器人/群聊里发 /stats 等被误触发
        if not is_saved:
            return
        if msg.text == '/start':
            await _reply(
                '收藏夹同步已开启。把视频/图片发到收藏夹，我自动存到网盘。\n'
                '当前网盘：%s\n'
                '20分钟以下进「短视频/」，20分钟以上建独立中文文件夹。\n'
                '命令：/drive 看/切网盘，/alipanlogin 阿里云盘扫码登录，'
                '/stats 传输状态，/history 最近记录，/clean 清理异常记录。\n'
                '/getbot @bot用户名 口令 —— 从防转发的 bot 取文件。'
                % ' + '.join(cloudmod.labels()))
            return
        if msg.text == '/alipanlogin':
            await _reply('🔐 正在生成阿里云盘登录二维码，马上发到你这里…')
            loop3 = asyncio.get_event_loop()

            async def _send_qr(png_path, caption):
                try:
                    await _reply(file=png_path, message=caption)
                except Exception as e:
                    print('ALIPAN_QR_TG_SEND_FAIL %r' % e, flush=True)

            def _do_alipan_login():
                from tg_bot import alipan_login
                return alipan_login.login_qr_loop(
                    send_tg_fn=_send_qr, main_loop=loop3)

            async def _alipan_login_runner():
                try:
                    await loop3.run_in_executor(None, _do_alipan_login)
                    await _reply('✅ 阿里云盘已接上，机器人可以往阿里云盘传文件了。')
                except Exception as e:
                    await _reply('❌ 阿里云盘登录失败：%s' % str(e)[:160])
            tasks.spawn(_alipan_login_runner(), 'alipan_login')
            return
        if msg.text.startswith('/drive') or msg.text.strip() == '/d':
            _parts = msg.text.split()
            if len(_parts) == 1:
                lines = ['🌐 当前网盘：%s' % ' + '.join(cloudmod.labels())]
                try:
                    _hs = await asyncio.get_event_loop().run_in_executor(
                        None, cloudmod.health)
                    for _k, _lab, _ok, _why in _hs:
                        lines.append('%s %s%s' % ('✅' if _ok else '❌', _lab,
                                                  '' if _ok else '：%s' % _why))
                except Exception as e:
                    lines.append('探测失败：%r' % (e,))
                lines.append('当前只有阿里云盘')
                await _reply('\n'.join(lines))
                return
            _arg = _parts[1].lower()
            if _arg == 'both':
                _keys = ['ali']
            elif _arg in cloudmod.KEYS:
                _keys = [_arg]
            else:
                await _reply('用法：/drive ali')
                return
            try:
                _keys = cloudmod.set_targets(_keys)
            except Exception as e:
                await _reply('❌ 切换失败：%s' % str(e)[:120])
                return
            await _reply('✅ 已切换到：%s'
                              % ' + '.join(cloudmod.labels(_keys)))
            return
        if msg.text == '/stats':
            ok, free = transfer.disk_ok(INBOX, 0)
            lines = ['📊 当前传输任务：%d' % len(tasks.active)]
            for key in list(tasks.active):
                st = tasks.active.get(key)
                if st is None:
                    continue
                prog = tasks.progress_of(key)
                if prog is None:
                    continue
                lines.append('• %s：%s' % (st.get('phase', '传输中'), prog))
            lines.append('💾 磁盘剩余：%.1fGB' % (free / 1073741824))
            await _reply('\n'.join(lines))
            return
        if msg.text == '/history':
            recs = history.read_history(10)
            if not recs:
                await _reply('📜 暂无传输记录。')
                return
            lines = ['📜 最近传输记录：']
            for r in reversed(recs):
                mark = '✅' if r.get('result') == 'ok' else '❌'
                if r.get('result') == 'ok':
                    lines.append('%s %s %s %s %d段 用时%s' % (
                        mark, r.get('ts', ''), r.get('folder', ''),
                        handlers.mb(r.get('size', 0)), r.get('parts', 0),
                        r.get('elapsed', '')))
                else:
                    lines.append('%s %s 失败：%s' % (
                        mark, r.get('ts', ''), r.get('error', '')[:60]))
            await _reply('\n'.join(lines))
            return
        if msg.text.startswith('/getbot') or msg.text.startswith('/gb '):
            await handlers._handle_getbot(event, msg.text)
            return
        if msg.text.startswith('/resume'):
            await handlers.handle_resume_cmd(event, msg.text)
            return
        if msg.text.startswith('/getcomments') or msg.text.startswith('/gc '):
            await handlers._handle_getcomments(event, msg.text)
            return
        if msg.text.strip() == '/gcstatus':
            _st = handlers.get_gc_status()
            if not _st:
                await event.reply('暂无评论拉取任务')
            else:
                import time as _t
                _phase = _st.get('phase', '?')
                _batches = _st.get('batches', 0)
                _found = _st.get('found', 0)
                _post = _st.get('post_id', '?')
                _elapsed = int(_t.time() - _st.get('start_ts', _t.time()))
                _phase_txt = {'scanning': '🔍 扫描中', 'scan_done': '✅ 扫描完成'}.get(_phase, _phase)
                await event.reply(
                    '💬 评论拉取状态\n帖子: %s\n状态: %s\n已扫: %d 批\n找到: %d 个媒体\n用时: %d 秒' % (
                        _post, _phase_txt, _batches, _found, _elapsed))
            return
        if msg.text.strip() == '/status':
            _ts = handlers.get_transfer_status()
            _lines = []
            import time as _t2
            # getbot 状态
            _gb = _ts.get('getbot', {})
            if _gb and _gb.get('phase') not in (None, 'done', ''):
                _phase = _gb.get('phase', '?')
                _bot = _gb.get('bot_username', '?')
                _elapsed = int(_t2.time() - _gb.get('start_ts', _t2.time()))
                if _phase == 'collecting':
                    _pages = _gb.get('pages_visited', [])
                    _col = _gb.get('collected', 0)
                    _lines.append(
                        '📦 取文件\n🤖 %s\n📍 翻页收集中\n📄 已访：%s\n📊 已收：%d 个\n⏱ %d 秒' % (
                            _bot, ','.join(map(str, _pages)) if _pages else '无',
                            _col, _elapsed))
                elif _phase == 'downloading':
                    _dl = _gb.get('downloaded', 0)
                    _tot = _gb.get('total', 0)
                    _lines.append(
                        '📦 取文件\n🤖 %s\n📍 下载中\n📊 %d/%d\n⏱ %d 秒' % (
                            _bot, _dl, _tot, _elapsed))
            # getcomments 状态（复用 gcstatus）
            _gc = _ts.get('getcomments', {}) or handlers.get_gc_status()
            if _gc and _gc.get('phase') not in (None, 'done', ''):
                _phase = _gc.get('phase', '?')
                _batches = _gc.get('batches', 0)
                _found = _gc.get('found', 0)
                _post = _gc.get('post_id', '?')
                _elapsed = int(_t2.time() - _gc.get('start_ts', _t2.time()))
                _phase_txt = {'scanning': '🔍 扫描中', 'scan_done': '✅ 扫描完成'}.get(_phase, _phase)
                _lines.append(
                    '💬 评论区\n📁 帖子：%s\n📍 %s\n📊 已扫 %d 批，找到 %d 个\n⏱ %d 秒' % (
                        _post, _phase_txt, _batches, _found, _elapsed))
            if not _lines:
                await event.reply('暂无进行中的转存任务')
            else:
                await event.reply('\n\n'.join(_lines))
            return
        if msg.text.strip() in ('/clean', '/c'):
            busy = set()
            for st in tasks.active.values():
                busy.update(st.get('local_paths', set()))
                if st.get('local_path'):
                    busy.add(st['local_path'])
            freed, count = 0, 0
            try:
                for f in os.listdir(INBOX):
                    p = os.path.join(INBOX, f)
                    if p in busy or not os.path.isfile(p):
                        continue
                    # 跳过 ffmpeg 切分中的临时分段文件（形如 xxx.seg001.mp4）
                    if re.search(r'\.seg\d{3}\.', f):
                        continue
                    try:
                        freed += os.path.getsize(p)
                        os.remove(p)
                        count += 1
                    except OSError:
                        pass
            except OSError as e:
                await _reply('清理失败：%s' % e)
                return
            await _reply('🧹 清理完成：删除 %d 个残留文件，释放 %s。'
                              % (count, handlers.mb(freed)))
            return
        if msg.text.strip() in ('/clearchat',):
            # 删除和 bot 聊天里的所有消息（用用户号，bot 号受限）
            try:
                _uclient = handlers._client
                if not _uclient:
                    await _reply('清空失败：用户号未初始化')
                    return
                _deleted = 0
                _bot_me = await event.client.get_me()
                async for _m in _uclient.iter_messages(_bot_me.id, limit=500):
                    try:
                        await _uclient.delete_messages(_bot_me.id, _m.id)
                        _deleted += 1
                    except Exception:
                        pass
                await _reply('🗑️ 已删除 %d 条消息' % _deleted)
            except Exception as e:
                await _reply('清空失败：%s' % str(e)[:100])
            return
        if msg.text and ('t.me/+' in msg.text or 't.me/joinchat/' in msg.text):
            if await handlers.handle_invite_link(event, msg.text):
                return
        if msg.text and 't.me/' in msg.text:
            await handlers.handle_tme_link(event, msg.text)
            return
        is_video = msg.video or (msg.document and msg.document.mime_type
                                 and msg.document.mime_type.startswith('video'))
        is_photo = msg.photo or (msg.document and msg.document.mime_type
                                 and msg.document.mime_type.startswith('image'))
        if is_video or is_photo:
            grouped_id = getattr(msg, 'grouped_id', None)
            if grouped_id:
                # 相册：防抖 3 秒，收集同 grouped_id 的所有消息一起处理
                import time as _t
                _now = _t.time()
                # 清理过期的
                for k in [k for k, v in _pending_albums.items() if _now - v > 30]:
                    del _pending_albums[k]
                if grouped_id in _pending_albums:
                    # 已在收集/处理中，跳过（由第一个触发的任务统一处理）
                    return
                _pending_albums[grouped_id] = _now
                try:
                    import time as _t2, random as _r2
                    _batch_id2 = 'b%d%d' % (int(_t2.time()), _r2.randint(1000, 9999))
                    notify.batch_init(_batch_id2)
                    ack = await notify.bot_notify('📥 收到相册，排队中…',
                                           buttons=notify.cancel_button('batch:' + _batch_id2))
                except Exception:
                    ack = None
                    _batch_id2 = None
                async def _process_album():
                    try:
                        # 等 3 秒让相册消息到齐
                        await asyncio.sleep(3)
                        # 从收藏夹取同 grouped_id 的消息
                        album_msgs = []
                        async for m in event.client.iter_messages(
                                event.chat_id, min_id=max(0, msg.id - 20),
                                max_id=msg.id + 20, limit=50):
                            if getattr(m, 'grouped_id', None) == grouped_id and m.media:
                                is_v = m.video or (m.document and m.document.mime_type
                                                   and m.document.mime_type.startswith('video'))
                                is_p = m.photo or (m.document and m.document.mime_type
                                                   and m.document.mime_type.startswith('image'))
                                if is_v or is_p:
                                    album_msgs.append(m)
                        # 去重排序
                        seen = set()
                        uniq = []
                        for m in album_msgs:
                            if m.id not in seen:
                                seen.add(m.id)
                                uniq.append(m)
                        uniq.sort(key=lambda m: m.id)
                        if not uniq:
                            uniq = [msg]
                        # 按 Telegram 文件大小去重：同一相册里大小完全相同的文件视为重复
                        # （解决 8 个解析出 11 个上传的问题）
                        _seen_sizes = set()
                        _deduped = []
                        for _m in uniq:
                            _fsz = getattr(getattr(_m, 'file', None), 'size', 0) or 0
                            if _fsz and _fsz in _seen_sizes:
                                print('ALBUM_SKIP_DUP_SIZE id=%d size=%d' % (_m.id, _fsz), flush=True)
                                continue
                            if _fsz:
                                _seen_sizes.add(_fsz)
                            _deduped.append(_m)
                        if len(_deduped) != len(uniq):
                            print('ALBUM_DEDUP %d -> %d' % (len(uniq), len(_deduped)), flush=True)
                        uniq = _deduped
                        await handlers._send(event, ack, '📥 收到 %d 个媒体，转存中…' % len(uniq))
                        # 建共享文件夹，一个个串行转存
                        cloud = None
                        if len(uniq) > 1:
                            try:
                                loop = asyncio.get_event_loop()
                                _names = [handlers._extract_msg_name(m) for m in uniq]
                                cloud = await loop.run_in_executor(None, handlers._prepare_cloud_album, _names)
                            except Exception:
                                cloud = None
                        ok = 0
                        _cid2 = getattr(event, 'chat_id', 'dm')
                        _details = []
                        _t0 = __import__('time').time()
                        # 整个相册批量拿全局锁，和其他任务串行
                        async with tasks._task_sem:
                            # 拿到锁：把"排队中"改成"转存中"
                            try:
                                await notify.bot_edit(ack, '📥 收到相册，转存中…')
                            except Exception:
                                pass
                            for i, m in enumerate(uniq, 1):
                                try:
                                    # 注册到批量取消
                                    if _batch_id2:
                                        notify.batch_register(_batch_id2, '%s_%s' % (_cid2, m.id))
                                    await handlers._send(event, ack, '📥 正在转存第 %d/%d 个…' % (i, len(uniq)))
                                    await handlers.handle_media(event, m, None, cloud, quiet=True, collector=_details)
                                    ok += 1
                                except Exception as e:
                                    print('ALBUM_ONE_FAIL %d: %r' % (m.id, e), flush=True)
                            # 循环结束后再清理批量记录（之前在循环内，每次都删导致取消按钮失效）
