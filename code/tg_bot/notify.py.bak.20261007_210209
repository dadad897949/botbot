VERSION = "1.5.5"  # 2026-10-06: 任务完成删开始消息，不残留  # 2026-10-06: /doctor 加 Reflect 洞察  # 2026-10-06: 修清空聊天内联按钮未知操作

import asyncio

# 由 runner.init_notify() 注入
_bot_client = None
_owner_id = None
_cancel_fn = None
_retry_fn = None
_tele_button = None

# 批量任务：batch_id -> [task_key, ...]
_batch_tasks = {}

# 滚动通知：只保留最新一条完成通知
_last_done_msg = None


_tasks_mod = None
_history_mod = None

_batch_status_fn = None

def init(bot_client, owner_id, cancel_fn, tele_button, tasks_mod=None, history_mod=None, retry_fn=None, batch_status_fn=None):
    """初始化通知模块。runner 启动时调用一次"""
    global _bot_client, _owner_id, _cancel_fn, _tele_button
    global _tasks_mod, _history_mod, _retry_fn, _batch_status_fn
    _bot_client = bot_client
    _owner_id = owner_id
    _cancel_fn = cancel_fn
    _tele_button = tele_button
    _tasks_mod = tasks_mod
    _history_mod = history_mod
    _retry_fn = retry_fn
    _batch_status_fn = batch_status_fn


async def bot_notify(text, buttons=None):
    """发通知到 bot，返回 message 对象（供后续编辑）"""
    if _bot_client is None:
        return None
    try:
        return await _bot_client.send_message(_owner_id, text, buttons=buttons)
    except Exception as e:
        print('BOT_NOTIFY_FAIL: %r' % e, flush=True)
        return None


def cancel_button(key):
    """生成取消按钮。key: 任务 key 或 batch:<batch_id>。
    callback_data 带 owner_id，防陌生人点击（按文章方案）。"""
    data = 'cancel:%s:%s' % (_owner_id, key)
    # 64 字节限制：key 太长则截断（batch_id 短，任务 key 是 chat_id_msgid，可控）
    if len(data.encode()) > 64:
        data = data[:64]
    return [[_tele_button.inline('❌ 取消', data=data.encode())]]


def retry_button(retry_id, fail_count):
    """生成重试按钮"""
    data = 'retry:%s:%s' % (_owner_id, retry_id)
    if len(data.encode()) > 64:
        data = data[:64]
    return [[_tele_button.inline('🔄 重试失败 (%d)' % fail_count, data=data.encode())]]


def batch_register(batch_id, key):
    """把任务 key 注册到批量里，用于一键取消"""
    if batch_id and key:
        _batch_tasks.setdefault(batch_id, []).append(key)


def batch_pop(batch_id):
    """取出并删除批量任务记录"""
    return _batch_tasks.pop(batch_id, None)


async def bot_edit(msg, text, buttons='KEEP'):
    """编辑 bot 通知消息。buttons='KEEP' 不动按钮，None 清除，列表则设置"""
    if msg is not None:
        try:
            if buttons == 'KEEP':
                await msg.edit(text)
            else:
                await msg.edit(text, buttons=buttons)
            return msg
        except Exception:
            pass
    return await bot_notify(text, buttons=None if buttons == 'KEEP' else buttons)


def schedule_bot_delete(msg, delay=86400):
    """24小时后删除 bot 消息"""
    if msg is None:
        return

    def _do():
        try:
            asyncio.create_task(msg.delete())
        except Exception:
            pass
    try:
        asyncio.get_event_loop().call_later(delay, _do)
    except Exception:
        pass


def get_last_done_msg():
    return _last_done_msg


def set_last_done_msg(msg):
    global _last_done_msg
    _last_done_msg = msg


async def reply_autodelete(event, ack, text, delay=86400, buttons=None):
    """汇总通知：删除旧的 ack（任务开始消息），发新的汇总，24h后删除。
    buttons=None 清按钮，传入则设置（用于重试按钮）。"""
    # 先删掉"任务开始"消息，避免残留
    try:
        if ack:
            await ack.delete()
    except Exception:
        pass
    _m = await bot_notify(text, buttons=buttons)
    schedule_bot_delete(_m, delay)
    return None


