    @bot_client.on(tele_events.CallbackQuery(pattern=b'^cancel:'))
    async def _on_cancel(ev):
        try:
            parts = ev.data.decode().split(':', 2)
            if len(parts) != 3:
                await ev.answer('参数错误')
                return
            uid, key = parts[1], parts[2]
            # 校验点击者是 owner
            if str(getattr(ev, 'sender_id', '')) != str(uid) or str(uid) != str(_owner_id):
                await ev.answer('无权操作', alert=True)
                return
            if key.startswith('batch:'):
                batch_id = key[6:]
                keys = _batch_tasks.pop(batch_id, [])
                ok = sum(1 for k in keys if _cancel_fn(k)) if _cancel_fn else 0
                await ev.answer('已取消 %d 个任务' % ok if ok else '任务已结束')
                if ok:
                    try:
                        await ev.edit('❌ 已取消（批量）', buttons=None)
                        _m = await ev.get_message()
                        schedule_bot_delete(_m, 86400)
                    except Exception:
                        pass
            else:
                # getbot 任务用 flag 机制
                if key.startswith('getbot'):
                    try:
                        from tg_bot import handlers as _h
                        ok = _h.cancel_getbot(key)
                    except Exception:
                        ok = False
                else:
                    ok = _cancel_fn(key) if _cancel_fn else False
                await ev.answer('已取消' if ok else '任务已结束或不存在')
        except Exception as e:
            try:
                await ev.answer('取消失败')
            except Exception:
                pass
            print('CANCEL_BTN_FAIL: %r' % e, flush=True)


    # 菜单动作的公共逻辑（内联按钮和键盘按钮复用）
    async def _menu_action_text(action):
        """返回对应动作的文本，复用逻辑不重复写"""
        if action == 'status':
            from tg_bot import tasks as _tm
            lines = ['📊 当前传输：%d 个' % len(_tm.active)]
            for key in list(_tm.active):
                st = _tm.active.get(key)
                if st and not st.get('placeholder'):
                    lines.append('• %s' % st.get('label', key)[:30])
            return '\n'.join(lines)
        elif action == 'cancel_all':
            from tg_bot import tasks as _tm
            n = 0
            for key in list(_tm.active):
                if _cancel_fn and _cancel_fn(key):
                    n += 1
            return '已取消 %d 个任务' % n if n else '没有运行中的任务'
        elif action == 'p91run':
            import subprocess
            subprocess.run(['systemctl', 'stop', '91porn.service'], timeout=5, capture_output=True)
            subprocess.run(['systemctl', 'start', '--no-block', '91porn.service'], timeout=5, capture_output=True)
            return '91porn 已启动'
        elif action == 'p91stop':
            import subprocess
            subprocess.run(['systemctl', 'stop', '91porn.service'], timeout=10, capture_output=True)
            return '91porn 已取消'
        elif action == 'history':
            recs = _history_mod.read_history(5) if _history_mod else []
            if not recs:
                return '暂无记录'
            lines = []
            for r in reversed(recs):
                mark = '✅' if r.get('result') == 'ok' else '❌'
                lines.append('%s %s %s' % (mark, r.get('ts', ''), r.get('folder', '')[:20]))
            return '\n'.join(lines)
        elif action == 'clean':
            # 直接清理，不推给收藏夹
            try:
                import os as _os, glob as _glob
                _tmp = '/tmp'
                _n = 0
                for _f in _glob.glob(_os.path.join(_tmp, 'tg_*')):
                    try:
                        _os.remove(_f)
                        _n += 1
                    except Exception:
                        pass
                return '已清理 %d 个临时文件' % _n if _n else '没有可清理的临时文件'
            except Exception as e:
                return '清理失败：%r' % e
        elif action == 'drive':
            # 直接查网盘状态，不推给收藏夹
            try:
                from tg_bot import cloud as _cm
                import asyncio as _aio
                lines = ['🌐 当前网盘：%s' % ' + '.join(_cm.labels())]
                _hs = await _aio.get_event_loop().run_in_executor(None, _cm.health)
                for _k, _lab, _ok, _why in _hs:
                    lines.append('%s %s%s' % ('✅' if _ok else '❌', _lab,
                                              '' if _ok else '：%s' % _why))
                lines.append('当前只有阿里云盘')
                return '\n'.join(lines)
            except Exception as e:
                return '网盘状态获取失败：%r' % e
        elif action == 'getbot':
            return '用法：/getbot @bot用户名 口令\n或直接发 t.me 机器人链接'
        elif action == 'getcomments':
            return '用法：\n/getcomments https://t.me/频道名/123\n下载该帖评论区的视频/图片'
        elif action == 'gcstatus':
            from tg_bot import handlers as _h
            _st = _h.get_gc_status()
            if not _st:
                return '暂无评论拉取任务'
            import time as _t
            _phase = _st.get('phase', '?')
            _batches = _st.get('batches', 0)
            _found = _st.get('found', 0)
            _post = _st.get('post_id', '?')
            _elapsed = int(_t.time() - _st.get('start_ts', _t.time()))
            _phase_txt = {'scanning': '🔍 扫描中', 'scan_done': '✅ 扫描完成'}.get(_phase, _phase)
            return ('💬 评论拉取状态\n帖子: %s\n状态: %s\n已扫: %d 批\n找到: %d 个媒体\n用时: %d 秒' % (
                _post, _phase_txt, _batches, _found, _elapsed))
        return '未知操作'

    @bot_client.on(tele_events.CallbackQuery(pattern=b'^menu:'))
    async def _on_menu(ev):
        """快捷菜单按钮回调"""
        try:
            parts = ev.data.decode().split(':', 2)
            if len(parts) != 3:
                await ev.answer('参数错误')
                return
            uid, action = parts[1], parts[2]
            if str(getattr(ev, 'sender_id', '')) != str(uid) or str(uid) != str(_owner_id):
                await ev.answer('无权操作', alert=True)
                return
            # clearchat 需要删消息，特殊处理（用用户号，bot 号受限）
            # 不能走 _menu_action_text（那只返回文本），这里要实际执行删除
            if action == 'clearchat':
                try:
                    from tg_bot import handlers as _h
                    _uclient = _h._client
                    if not _uclient:
                        await ev.answer('清空失败：用户号未初始化', alert=True)
                        return
                    _deleted = 0
                    _me = await bot_client.get_me()
                    _bot_id = _me.id
                    async for _m in _uclient.iter_messages(_bot_id, limit=500):
                        try:
                            await _uclient.delete_messages(_bot_id, _m.id)
                            _deleted += 1
                        except Exception:
                            pass
                    await ev.answer('🗑️ 已删除 %d 条消息' % _deleted, alert=True)
                except Exception as e:
                    await ev.answer('清空失败：%s' % str(e)[:100], alert=True)
                return
            text = await _menu_action_text(action)
            await ev.answer(text, alert=True)
        except Exception as e:
            try:
                await ev.answer('操作失败')
            except Exception:
                pass
            print('MENU_BTN_FAIL: %r' % e, flush=True)


def batch_init(batch_id, keys=None):
