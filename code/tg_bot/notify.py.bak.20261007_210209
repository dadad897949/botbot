    @bot_client.on(tele_events.NewMessage(pattern=r'^/(doctor|doc)$'))
    async def _on_doctor_cmd(ev):
        """系统体检：学 Agent-Reach 的 doctor 模式，一条命令看所有状态。"""
        if str(getattr(ev, 'sender_id', '')) != str(_owner_id):
            return
        lines = ['🩺 系统体检']
        # 1. Session 健康
        try:
            from tg_bot import health as _hl
            h = _hl.get_health()
            for name, st in h.items():
                icon = '✅' if st['ok'] else '❌'
                lines.append('%s %s (失败%d次，重连%d次)' % (
                    icon, name, st['fails'], st['reconnects']))
        except Exception as e:
            lines.append('❌ 健康检查模块异常：%s' % str(e)[:40])
        # 2. 阿里云盘（放线程池，避免阻塞事件循环）
        try:
            import asyncio as _aio
            from tg_bot import alipan as _ap
            def _probe():
                try:
                    _ap.get_ali()
                    return None
                except Exception as e:
                    return type(e).__name__
            err = await _aio.wait_for(
                _aio.to_thread(_probe), timeout=35)
            if err is None:
                lines.append('✅ 阿里云盘登录正常')
            else:
                lines.append('❌ 阿里云盘：%s' % err)
        except Exception as e:
            lines.append('❌ 阿里云盘检查超时')
        # 3. 磁盘空间
        try:
            import shutil as _sh
            total, used, free = _sh.disk_usage('/')
            lines.append('💾 磁盘：可用 %.1fG / 总 %.1fG' % (
                free / 1073741824, total / 1073741824))
        except Exception:
            lines.append('❌ 磁盘检查失败')
        # 4. 任务状态
        try:
            n = len(_tasks_mod.active) if _tasks_mod else 0
            lines.append('📊 活动任务：%d' % n)
        except Exception:
            pass
        # 5. Hindsight Reflect: 学习洞察
        try:
            from tg_bot import learnings as _ln
            for _src in ('收藏夹',):
                _insight = _ln.reflect(_src)
                if _insight:
                    lines.append(_insight)
        except Exception:
            pass
        try:
            await ev.reply('\n'.join(lines))
            await ev.delete()
        except Exception:
            pass

