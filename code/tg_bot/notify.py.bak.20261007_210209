def _fmt_size(n):
    if n >= 1073741824:
        return '%.1fGB' % (n / 1073741824)
    return '%.0fMB' % (n / 1048576)


def build_summary(ok_count, total, details, elapsed_sec, label):
    """构建转存完成汇总消息（精简版）。

    不列单个文件名，只给总数+图片/视频拆分+用时。
    失败时才列失败文件名。

    details: [{'name', 'size', 'parts', 'folder', 'duration'}, ...]
    label: 类型标签，必填，如 '转存'、'评论转存'、'链接转存'、'取文件'
    """
    fail_count = total - ok_count

    # 图片/视频拆分（优先用 is_photo 字段，兼容旧的文件名前缀判断）
    ok_photo = sum(1 for d in details if d.get('is_photo') or d.get('name', '').startswith('photo_'))
    ok_video = ok_count - ok_photo

    # 用时格式化
    if elapsed_sec > 0:
        sec = int(elapsed_sec)
        if sec < 60:
            t = '%d秒' % sec
        else:
            m, s = divmod(sec, 60)
            t = '%d分%02d秒' % (m, s) if m < 60 else '%d小时%02d分' % (m // 60, m % 60)
    else:
        t = ''

    # 文件夹
    folder = details[0].get('folder', '') if details else ''

    if fail_count == 0:
        lines = ['✅ %s完成 %d/%d' % (label, ok_count, total)]
        if folder:
            lines.append('📁 %s' % folder)
        if t:
            lines.append('⏱ 用时 %s' % t)
        lines.append('📷 图片 %d · 🎬 视频 %d' % (ok_photo, ok_video))
    else:
        if ok_count == 0:
            lines = ['❌ %s失败 %d/%d' % (label, ok_count, total)]
        else:
            lines = ['⚠️ %s完成 %d/%d（%d 失败）' % (label, ok_count, total, fail_count)]
        if folder:
            lines.append('📁 %s' % folder)
        if t:
            lines.append('⏱ 用时 %s' % t)
        lines.append('📷 图片 %d · 🎬 视频 %d' % (ok_photo, ok_video))
        # 失败才列文件名（最多 5 个）
        # 注意：details 只含成功的，失败的需要调用方传入，这里只显示占位
        # 调用方如需列失败名，请自行拼接

    return '\n'.join(lines)
