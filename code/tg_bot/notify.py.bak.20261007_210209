    @bot_client.on(tele_events.NewMessage(pattern=r'^/(stats|status|st)$'))
    async def _on_stats_cmd(ev):
        # 只响应 owner
        if str(getattr(ev, 'sender_id', '')) != str(_owner_id):
            return
        from telethon import Button as _B
        try:
            n_active = len(_tasks_mod.active) if _tasks_mod else 0
            lines = ['📊 当前 %d 个传输中' % n_active]
            # 批量任务整体进度
            if _batch_status_fn:
                for bid, bs in _batch_status_fn().items():
                    done = len(bs.get('details', []))
                    total = bs.get('total', 0)
                    label = bs.get('label', bid)
                    if total > 0:
                        lines.append('📦 %s：%d/%d' % (label, done, total))
            text = '\n'.join(lines)
            buttons = [[_B.inline('❌ 关闭', data=('stats:%s:close' % _owner_id).encode())]]
            # 复用 menu 方式：删旧消息
            _sid = _get_stats_id()
            if _sid:
                try:
                    await bot_client.delete_messages(ev.chat_id, [_sid])
                except Exception:
                    pass
            msg = await ev.reply(text, buttons=buttons)
            _set_stats_id(msg.id)
            try:
                await ev.delete()
            except Exception:
                pass
        except Exception as e:
            await ev.reply('查询失败：%s' % str(e)[:60])

