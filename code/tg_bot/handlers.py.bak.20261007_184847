def _extract_cn(name, max_len=20):
    """从文件名提取中文字符，用于文件夹命名。无中文返回空"""
    import re
    cn = ''.join(re.findall(r'[\u4e00-\u9fff]+', name))
    return cn[:max_len] if cn else ''


