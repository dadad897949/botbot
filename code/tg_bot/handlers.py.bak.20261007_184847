def mb(n):
    return '%.1fMB' % (n / 1048576)


def fmt_elapsed(sec):
    sec = int(sec)
    if sec < 60:
        return '%d秒' % sec
    m, s = divmod(sec, 60)
    if m < 60:
        return '%d分%d秒' % (m, s)
    h, m = divmod(m, 60)
    return '%d小时%d分' % (h, m)


def fmt_duration(sec):
    sec = int(sec or 0)
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return '%d:%02d:%02d' % (h, m, s) if h else '%d:%02d' % (m, s)


